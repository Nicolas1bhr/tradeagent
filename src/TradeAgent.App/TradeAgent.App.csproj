<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>TradeAgent</AssemblyName>
    <RootNamespace>TradeAgent.App</RootNamespace>
    <ApplicationManifest Condition="Exists('app.manifest')">app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia over WPF/WinUI: it builds and runs on the CI/dev host as well as Windows, ships
         self-contained with no runtime prerequisite for the user, and has the lowest packaging risk
         of the three. See docs/DECISIONS.md. -->
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- THE HEAD-START KIT A BUILD CARRIES (U-kit-socket): the repository's kit/ — an empty index until the owner hands his kit over —
         beside the app's programs, installed at the first start (Kit.InstallBundled) and never over the owner's own install or removal.
         To bundle the owner's kit into a build, put it in kit/ at the repository's root, laid out as Kit.cs says. -->
    <Content Include="../../kit/**" LinkBase="kit" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TradeAgent.UnitTests" />
    <InternalsVisibleTo Include="TradeAgent.UiTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../TradeAgent.Gateway/TradeAgent.Gateway.csproj" />
    <ProjectReference Include="../TradeAgent.Connectors.Fake/TradeAgent.Connectors.Fake.csproj" />
    <ProjectReference Include="../TradeAgent.Connectors.Atas/TradeAgent.Connectors.Atas.csproj" />
    <ProjectReference Include="../TradeAgent.AgentRuntime/TradeAgent.AgentRuntime.csproj" />
    <ProjectReference Include="../TradeAgent.Diagnostics/TradeAgent.Diagnostics.csproj" />
    <ProjectReference Include="../TradeAgent.TradeCli/TradeAgent.TradeCli.csproj" />
    <ProjectReference Include="..\TradeAgent.Connectors.Paper\TradeAgent.Connectors.Paper.csproj" />
    <ProjectReference Include="..\TradeAgent.Platforms\TradeAgent.Platforms.csproj" />
  </ItemGroup>
</Project>
