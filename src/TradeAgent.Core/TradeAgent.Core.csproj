<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <!-- Pinned ahead of the version Microsoft.Data.Sqlite 10.0.0 pulls in: 2.1.11 carries
         GHSA-2m69-gcr7-jv3q (high). Same major, so the provider API is unchanged. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>
  <ItemGroup>
    <!-- U-tls-denylist: the certificate authorities every secure connection is checked against. DATA, shipped beside the
         binaries like a vendor file, so a later change to the list is a data change; read by TlsDenylist.ShippedPath. -->
    <Content Include="Tls/tls-denylist.json" Link="tls-denylist.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TradeAgent.UnitTests" />
    <!-- THE PROVING HOST (U-proving-ground-c): a test program, never packaged, that sets the proving and puppet flags first. -->
    <InternalsVisibleTo Include="TradeAgent.ProvingHost" />
    <!-- The Linux cell rows (U-cell-linux-d) grant ephemeral ports through CellEgress.ForTests, a table no product code can name. -->
    <InternalsVisibleTo Include="TradeAgent.IntegrationTests" />
  </ItemGroup>
</Project>
