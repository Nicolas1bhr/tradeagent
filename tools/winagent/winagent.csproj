<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The in-session UI agent. Runs ON the Windows test machine, INSIDE the interactive desktop
    session, and is driven from the dev Mac over SSH.

    net10.0-windows with both UseWPF and UseWindowsForms: that is what brings in
    System.Windows.Automation (UI Automation, from UIAutomationClient) and System.Drawing
    (screen capture) without a single NuGet package. A tool whose whole job is to work on one
    machine should not also depend on that machine's ability to restore packages.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>winagent</AssemblyName>
    <RootNamespace>TradeAgent.WinAgent</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
