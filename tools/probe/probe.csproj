<Project Sdk="Microsoft.NET.Sdk">
  <!-- Deliberately NOT in TradeAgent.sln: this is a verification harness, not something that ships,
       and it must never end up inside a packaged build. Relative ProjectReferences so it works from
       its committed location rather than from wherever it was first written. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>probe</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/TradeAgent.AgentRuntime/TradeAgent.AgentRuntime.csproj" />
    <!-- `probe atas` talks the real bridge protocol and reuses the real AtasConnector, so the wire
         shapes and the capability derivation cannot drift away from the product's. Both projects
         target plain net10.0, so this harness still builds on the macOS dev machine. -->
    <ProjectReference Include="../../src/TradeAgent.Connectors.Atas/TradeAgent.Connectors.Atas.csproj" />
  </ItemGroup>
</Project>
