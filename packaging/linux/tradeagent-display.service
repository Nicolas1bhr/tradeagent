# TradeAgent's display: one X server that is itself the VNC server (TigerVNC's Xvnc), listening on ONE
# address — the owner's private network — with VNC password authentication, and an X cookie so that no
# other account on this host can open the window. The owner looks at the app from his Mac's Screen
# Sharing; nothing in the app listens on a network, and every control stays the window's.
#
# A template: packaging/linux/install.sh fills its placeholders in and installs it root-owned in
# /etc/systemd/system, so the app's own account — which is the agent's — cannot change it.
[Unit]
Description=TradeAgent's display (Xvnc :@DISPLAY@ on @ADDRESS@ only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@ACCOUNT@
Group=@ACCOUNT@
UMask=0077
# THE ADDRESS FIRST, BOUNDED (U-window-door): a tailnet address can appear after this unit starts at boot, and an Xvnc that
# failed its bind failed this start job and, through Requires=, the app's, which nothing starts again. 90 s is the wait: it
# covers a network daemon that brings its interface up from its own saved state after boot, and stays inside this unit's
# TimeoutStartSec below (the wait, the cookie and the socket's 10 s together). Past it the start fails as before, and
# Restart=always keeps trying the display; the app then needs a start by hand (the kit's next run does it).
ExecStartPre=@KIT@/display-prepare address @ADDRESS@ 90
ExecStartPre=+@KIT@/display-prepare x11-dir
ExecStartPre=@KIT@/display-prepare cookie @HOME@/.Xauthority :@DISPLAY@
ExecStart=@XVNC@ :@DISPLAY@ -geometry @GEOMETRY@ -depth 24 -interface @ADDRESS@ -rfbport @PORT@ -SecurityTypes VncAuth -PasswordFile @HOME@/.vnc/vncauth -auth @HOME@/.Xauthority -nolisten tcp -desktop TradeAgent
ExecStartPost=@KIT@/display-prepare wait :@DISPLAY@
# A failed start (an address that never came, an Xvnc that died) is retried every 5 s.
Restart=always
RestartSec=5
TimeoutStartSec=150

[Install]
WantedBy=multi-user.target
